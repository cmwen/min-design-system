{
  "name": "@cmwen/min-design-system",
  "version": "0.3.0",
  "description": "CSS-first organic themes for native HTML",
  "type": "module",
  "license": "MIT",
  "private": false,
  "files": [
    "src",
    "dist/assets/forest-and-fern.css",
    "LICENSE",
    "README.md",
    "docs/INSTALL.md",
    "docs/STORYBOOK.md",
    "docs/RELEASE.md"
  ],
  "exports": {
    ".": "./src/index.css",
    "./*.css": "./src/*.css",
    "./forest-and-fern.css": "./dist/assets/forest-and-fern.css",
    "./tabs": "./src/tabs.js",
    "./theme": "./src/theme.js"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-css.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && biome lint src playground/styles.css",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:visual:update": "playwright test --project=chromium --grep visual --update-snapshots",
    "check": "npm run lint && npm test && npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:storybook": "playwright test --config playwright.storybook.config.js",
    "release:configure": "node scripts/configure-release.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/html-vite": "10.6.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "storybook": "10.6.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "style": "./src/index.css",
  "keywords": [
    "css",
    "design-system",
    "native-html",
    "accessible",
    "themes",
    "forest-and-fern"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmwen/min-design-system.git"
  },
  "homepage": "https://cmwen.dev/min-design-system/",
  "bugs": {
    "url": "https://github.com/cmwen/min-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
